#!/bin/bash

set -e

html=$(typst compile gallery/index.typ - --format html --features html)
images=$(echo $html | tr '<' '\n' | grep -o 'img src="[^"]*"' | sed -E 's/img src="([^"]*)"/\1/')

for img in ${images[@]}; do
    outpath=$(echo $img | sed -e 's:gallery/assets:/gallery:' | sed -E 's/.heic/.avif/')
    if [[ -f "dist$outpath" ]]; then
        echo "Skipped $img" >&2
        continue
    fi
    (
        mkdir -p $(dirname "dist$outpath")
        sips -s format avif --resampleWidth 800 "$img" --out "dist$outpath"
    ) &
done

wait

for img in ${images[@]}; do
    outpath=$(echo $img | sed -e 's:gallery/assets:/gallery:' | sed -E 's/.heic/.avif/')
    width=$(sips -g pixelWidth "dist$outpath" | grep -o 'pixelWidth: \d*' | cut -c 13-)
    height=$(sips -g pixelHeight "dist$outpath" | grep -o 'pixelHeight: \d*' | cut -c 14-)
    html=$(echo "$html" | sed -e "s:<img src=\"$img\":<img src=\"${outpath}\" width=\"${width}\" height=\"${height}\":")
done

echo $html > dist/gallery/index.html
